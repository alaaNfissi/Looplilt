  "scenes": [
    {
      "id": "arrival",
      "label": "The keeper arrives",
      "start": 0,
      "end": 6,
      "description": "A small clockwork keeper crosses a sleeping hillside toward an observatory. One patch of sky remains dark.",
      "params": {
        "accent": "#e5b772"
      }
    },
    {
      "id": "search",
      "label": "An empty chart",
      "start": 6,
      "end": 12,
      "description": "Inside the dome, the keeper checks the telescope and a star chart. The sight never settles.",
      "params": {
        "accent": "#e5b772"
      }
    },
    {
      "id": "repair",
      "label": "The missing part",
      "start": 12,
      "end": 18,
      "description": "A close view of the brass mechanism reveals an empty space. A small green gear fits, and the entire train begins to turn.",
      "params": {
        "accent": "#e5b772"
      }
    },
    {
      "id": "alignment",
      "label": "Finding the sky",
      "start": 18,
      "end": 24,
      "description": "The repaired telescope tilts upward. A beam leaves its lens as the keeper steps back.",
      "params": {
        "accent": "#e5b772"
      }
    },
    {
      "id": "reply",
      "label": "The sky answers",
      "start": 24,
      "end": 32,
      "description": "The dome opens. A thread of light draws a bird-shaped constellation, and the keeper raises both hands beneath it.",
      "params": {
        "accent": "#e5b772",
        "glow": 1
      }
    }
  ],
