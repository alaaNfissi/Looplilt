      "start": 1,
      "end": 4.5,
      "text": "Waves pass through each other. Their displacements add."
    },
    {
      "start": 7,
      "end": 11.5,
      "text": "Matching peaks make a larger wave."
    },
    {
      "start": 15,
      "end": 19.5,
      "text": "Equal, opposite displacements can sum to zero."
    },
    {
      "start": 22,
      "end": 25.5,
      "text": "At different places, waves meet with different phases."
    },
    {
      "start": 28,
      "end": 31.5,
      "text": "The result depends on both contributions."
    }
